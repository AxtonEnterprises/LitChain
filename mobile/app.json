{
  "expo": {
    "name": "Lit Chain",
    "slug": "lit-chain",
    "owner": "axton-enterprisess-organization",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "litchain",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#F4F8F8",
    "icon": "../public/branding/lit-chain-icon-512.png",
    "splash": {
      "image": "../public/branding/lit-chain-icon-512.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F8F8"
    },
    "android": {
      "package": "org.theliteraturefoundation.litchain",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "../public/branding/lit-chain-icon-512.png",
        "backgroundColor": "#F4F8F8"
      }
    },
    "ios": {
      "bundleIdentifier": "org.theliteraturefoundation.litchain",
      "buildNumber": "1",
      "supportsTablet": true,
      "icon": "../public/branding/lit-chain-icon-512.png"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "67eb8faa-536a-4b86-8b99-7602fa9da15d"
      }
    }
  }
}
