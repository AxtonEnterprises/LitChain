{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "litchain",
  "main": "worker.js",
  "compatibility_date": "2026-09-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/__/auth/*",
      "/__/firebase/init.json"
    ]
  }
}
